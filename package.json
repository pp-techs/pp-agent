{
  "name": "pp-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter @workspace/web --filter @workspace/desktop dev",
    "build": "vp run -r build",
    "dist": "vp run @workspace/web#build && vp run @workspace/desktop#dist",
    "ready": "vp check && vp run -r build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
