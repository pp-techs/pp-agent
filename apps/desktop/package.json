{
  "name": "@workspace/desktop",
  "version": "0.13.0",
  "private": true,
  "description": "PP Agent desktop app",
  "homepage": "https://github.com/pp-techs/pp-agent",
  "license": "Apache-2.0",
  "author": {
    "name": "PP Techs",
    "url": "https://github.com/pp-techs"
  },
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack",
    "start": "electron .",
    "fetch:webclaw": "node scripts/fetch-webclaw.mjs",
    "dist": "node scripts/fetch-webclaw.mjs && vp pack && electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "node scripts/fetch-webclaw.mjs && vp pack && electron-builder --config electron-builder.yml --dir --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@napi-rs/keyring": "^2.1.2",
    "electron-updater": "^6.8.11",
    "fflate": "catalog:",
    "i18next": "catalog:",
    "officeparser": "catalog:",
    "typebox": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@types/node": "catalog:",
    "@workspace/agent-core": "workspace:*",
    "@workspace/daemon": "workspace:*",
    "@workspace/shared": "workspace:*",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "productName": "PP Agent"
}
