<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone in a cloud backup or a device-to-device transfer. The app
     keeps only the computer's address and its device token (WebView storage); a copied token would
     let another phone act as this one, so the new phone pairs again instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
